[include]
    path = ~/.gitconfig.local
[init]
    defaultBranch = main
[color]
    ui = auto
[color "branch"]
    current = red
    remote = green
[alias]
    undo = reset --soft HEAD~1
    unstage = reset HEAD --
    who = shortlog -sne --all --no-merges
    br = branch
    st = status
    cm = commit
[pull]
    rebase = true
[push]
    autoSetupRemote = true
[fetch]
    prune = true
[diff]
    algorithm = histogram
[help]
    autocorrect = 1
[core]
    excludesFile = ~/.gitignore_global
