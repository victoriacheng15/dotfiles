[user]
    name = Victoria Cheng
    email = victoria.cheng15@gmail.com
[init]
    defaultBranch = main
[color]
    ui = auto
[alias]
    undo = reset --soft HEAD~1
    unstage = reset HEAD --
    who = shortlog -sne --all --no-merges
[pull]
    rebase = true
[fetch]
    prune = true
[help]
    autocorrect = 1