[include]
    path = ~/.gitconfig.local
[init]
    defaultBranch = main
[color]
    ui = auto
[color "branch"]
    current = red
    remote = green
[alias]
    undo = reset --soft HEAD~1
    unstage = reset HEAD --
    who = shortlog -sne --all --no-merges
[pull]
    rebase = true
[fetch]
    prune = true
[help]
    autocorrect = 1