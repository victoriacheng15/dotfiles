[user]
    name = Victoria Cheng
    email = victoria.cheng15@gmail.com
[init]
    defaultBranch = main
[color]
    ui = auto
[alias]
    st = status
    co = checkout
    br = branch
    ci = commit
    tree = log --oneline --graph --decorate --all
    last = log -1 HEAD
    unstage = reset HEAD --
    amend = commit --amend --no-edit
    undo = reset --soft HEAD~1
    hist = log --pretty=format:'%h %ad | %s%d [%an]' --graph --date=short
    who = shortlog -sne --all --no-merges
    recent = log --pretty=format:'%C(yellow)%h%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative -n 10
[pull]
    rebase = true
[fetch]
    prune = true
[help]
    autocorrect = 1