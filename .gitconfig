[user]
    name = Victoria Cheng
    email = victoria.cheng15@gmail.com
[init]
    defaultBranch = main
[color]
    ui = auto
[alias]
    g = !git
    amend = commit --amend --no-edit
    ga = add
    gb = branch
    gc = commit
    gco = checkout
    gd = diff
    gl = log --oneline --graph --decorate --all
    gp = push
    gst = stash
    hist = log --pretty=format:'%h %ad | %s%d [%an]' --graph --date=short
    last = log -1 HEAD
    recent = log --pretty=format:'%C(yellow)%h%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative -n 10
    st = status
    tree = log --oneline --graph --decorate --all
    undo = reset --soft HEAD~1
    unstage = reset HEAD --
    who = shortlog -sne --all --no-merges
[pull]
    rebase = true
[fetch]
    prune = true
[help]
    autocorrect = 1